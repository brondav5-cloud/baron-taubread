# Supabase Configuration
# Copy this file to .env.local and fill in your credentials
# Values on Vercel are base64-encoded (see src/lib/supabase/env.ts)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Solvit ERP (server-only, never NEXT_PUBLIC)
ERP_MCP_BASE_URL=https://nihulkav.online:4000
ERP_MCP_TOKEN=
